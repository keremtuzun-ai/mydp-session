# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL and anon key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. SERVER ONLY. Never expose to the browser. Used by the seed
# script, the username→email lookup at sign-in, signed download URLs and audit
# logging.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── School access control ──────────────────────────────────────────────────
# Comma-separated list of email domains that may create an account.
# Subdomains are NOT matched automatically; list each one explicitly.
ALLOWED_SCHOOL_DOMAINS=school.edu,stu.school.edu

# ── App ───────────────────────────────────────────────────────────────────
# Public origin of the app. Used for auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MUN Session Hub"
NEXT_PUBLIC_SCHOOL_NAME="Your School"

# IANA timezone for every displayed date (Vercel servers run in UTC).
NEXT_PUBLIC_TIMEZONE=Europe/Istanbul

# Upload limits (bytes). Default 15 MB.
MAX_UPLOAD_BYTES=15728640

# ── Seed script only ──────────────────────────────────────────────────────
# Password given to every seeded development account. Local development only.
SEED_PASSWORD=MunHub!2026

# ── Executive invite link ─────────────────────────────────────────────────
# Secret path segment for /exec-invite/<token>. Anyone with the link can add
# their school email to the executive allow-list. Rotate it to revoke the link.
EXEC_INVITE_TOKEN=

# Password of the single shared executive account, asked for on the secret
# link. Create or update the account with: npm run exec:account
EXEC_SHARED_PASSWORD=
# Optional: email of the shared account (default secretariat@<first allowed domain>).
EXEC_ACCOUNT_EMAIL=
